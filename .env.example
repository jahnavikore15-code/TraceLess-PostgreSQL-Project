# Hosted PostgreSQL (required for Vercel / production)
# Example (Neon, Supabase, Render, Railway, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/traceless_db?sslmode=require

# Local PostgreSQL development fallback (ignored when DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traceless_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Secret key for Flask session cookies (set a strong random string in Vercel)
SECRET_KEY=replace-this-with-a-long-random-secret
